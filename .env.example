# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK for Android.
# Enable "Maps SDK for Android" in the Google Cloud Console.
# Users configure this in AI Studio Secrets panel or in local .env.
MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_API_KEY_HERE

# PRODUCTION_BACKEND_URL: Base URL for production PathFinder REST API (must be HTTPS)
PRODUCTION_BACKEND_URL=https://api.pathfinder-ai.com/api/

