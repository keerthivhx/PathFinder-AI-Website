# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb://localhost:27017/pathfinder_ai
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pathfinder_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pathfinder_ai

# JWT Secret for User/Admin Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*
